---
import Base from '../layouts/Base.astro';
import Motifs from '../components/Motifs.astro';
import LoveStamp from '../components/LoveStamp.astro';
import bio from '../../content/bio.json';
import site from '../../content/site.json';
const paras = bio.long.split('\n\n');
---
<Base current="bio" title="About" description={bio.short}>
  <section class="hero" style="position:relative">
    <Motifs seed="origin-hero" count={10} />
    <div class="wrap hero-inner" style="position:relative">
      <p class="eyebrow reveal">okay, the longer version.</p>
      <h1 class="hero-title reveal">
        <span class="wobble">A little</span> <span class="wobble stroke">about me.</span>
      </h1>
      <p class="hero-sub reveal">
        You asked (kind of, by clicking). So here’s the fuller story &mdash; where I come from,
        what I’ve worked on, and what I actually think about all of it.
      </p>
    </div>
    <div style="position:absolute; right: clamp(1rem, 4vw, 3rem); top: clamp(1rem, 4vw, 2rem); z-index:1">
      <LoveStamp size={110} tilt={-14} />
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="display:grid; grid-template-columns:minmax(0,1fr); gap:3rem; align-items:start;">
      <article class="bio-body reveal">
        {paras.map((p) => <p>{p}</p>)}
      </article>

      <aside class="reveal" style="border:3px solid var(--ink); background:var(--paper); box-shadow:var(--shadow-punch); padding:1.5rem;">
        <p class="eyebrow mb-1">Things I’ve worked on</p>
        <ul class="mono small" style="list-style:none; padding:0; margin:0; display:grid; gap:0.6rem">
          <li>&middot; Photography for National Geographic</li>
          <li>&middot; Creative work with The Hershey Company</li>
          <li>&middot; Running the creative engine at UberFacts</li>
          <li>&middot; Founding CLR Wear (custom-fit apparel)</li>
          <li>&middot; Bias research at Johns Hopkins</li>
          <li>&middot; Theater in college (still uses it)</li>
          <li>&middot; Reading a lot of Dewey and West</li>
        </ul>
        <p class="mt-3 mb-1 eyebrow">Want to say hi?</p>
        <p class="mono small">
          <a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>
        <div class="mt-2">
          {site.contact.socials.map((s) => (
            <a class="chip" href={s.url} rel="noopener noreferrer" target="_blank">{s.label} &#8599;</a>
          ))}
        </div>
      </aside>
    </div>
  </section>
</Base>
