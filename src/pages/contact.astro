---
import Base from '../layouts/Base.astro';
import Motifs from '../components/Motifs.astro';
import site from '../../content/site.json';
---
<Base current="contact" title="Say hi" description="Get in touch with Davy Mellado.">
  <section class="hero" style="position:relative">
    <Motifs seed="signal-hero" count={10} />
    <div class="wrap hero-inner" style="position:relative">
      <p class="eyebrow reveal">i’d actually love to hear from you.</p>
      <h1 class="hero-title reveal">
        <span class="wobble">Say</span> <span class="wobble stroke">hi.</span>
      </h1>
      <p class="hero-sub reveal">
        Working on a project, wondering about something, or just want to argue about pragmatism
        at 2am? Either of the below works. I read everything that comes in.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="display:grid; grid-template-columns: minmax(0, 1fr); gap:3rem;">
      <form
        class="contact-form reveal"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contact/thanks"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p style="display:none"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>

        <div>
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div>
          <label for="email">Your email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div>
          <label for="subject">What’s it about?</label>
          <input id="subject" name="subject" type="text" placeholder="a project, a question, a plot twist..." />
        </div>
        <div>
          <label for="message">Say whatever you want to say</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <div>
          <button type="submit" class="btn">Send it over →</button>
        </div>
      </form>

      <aside class="reveal" style="border:3px solid var(--ink); background:var(--lime); box-shadow:var(--shadow-punch); padding:1.5rem;">
        <p class="eyebrow mb-1">Or just email me directly:</p>
        <p class="mono small">
          <a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>
        <p class="mono small mb-1 mt-2">Or find me around:</p>
        <div>
          {site.contact.socials.map((s) => (
            <a class="chip" href={s.url} rel="noopener noreferrer" target="_blank">{s.label} ↗</a>
          ))}
        </div>
      </aside>
    </div>
  </section>
</Base>
